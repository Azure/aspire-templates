<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Aspire 17.0.0 is published to the Aspire release feed before nuget.org; remove that source once it is on nuget.org. -->
  <packageSources>
    <clear />
    <add key="aspire-17.0.0" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/darc-pub-microsoft-aspire-a509f094/nuget/v3/index.json" />
    <add key="nuget-public" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="aspire-17.0.0">
      <package pattern="Aspire.*" />
    </packageSource>
    <packageSource key="nuget-public">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
