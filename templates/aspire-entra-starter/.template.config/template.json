    },
    "replaceDnsInvalidCharsWithHyphens": {
      "identifier": "replace",
      "pattern": "[^a-z0-9-]",
      "replacement": "-"
    },
    "replaceRepeatedHyphens": {
      "identifier": "replace",
      "pattern": "-{2,}",
      "replacement": "-"
    },
    "trimLeadingHyphens": {
      "identifier": "replace",
      "pattern": "^-+",
      "replacement": ""
    },
    "trimTrailingHyphens": {
