<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>fd6ca176-4f2e-481c-ac22-11713fd55bc9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="HostingAppHostPackageVersion" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="HostingDotnetPackageVersion" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="HostingAzureAppContainersPackageVersion" />
    <PackageReference Include="Aspire.Hosting.Azure.EntraId" Version="HostingAzureEntraIdPackageVersion" />
  </ItemGroup>

  <!--#if (UseRedisCache) -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Redis" Version="HostingAzureRedisPackageVersion" />
  </ItemGroup>

  <!--#endif -->
</Project>
